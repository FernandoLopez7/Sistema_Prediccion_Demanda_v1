generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  products  Product[]
  materials Material[]

  @@map("units")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  googleId  String?  @unique @map("google_id")
  name      String?
  role      Role     @default(VIEWER) // 👈 NUEVO
  createdAt DateTime @default(now()) @map("created_at")

  Branches       Branch[]
  stockMovements StockMovement[]
  materials      Material[]
  products       Product[]
  sales          Sale[]

  @@map("users")
}

model Branch {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id])
  products      Product[]
  materials     Material[]
  sales         Sale[]
  stockMovements StockMovement[]

  @@map("branches")
}

model Product {
  id             String          @id @default(cuid())
  userId         String          @map("user_id")
  name           String
  code           String?
  unitId         String          @map("unit_id")
  stock          Float           @default(0) // 👈 NUEVO
  safetyStock    Float           @default(0) @map("safety_stock")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")
  branchId       String          @map("Sucursal")
  unit           Unit            @relation(fields: [unitId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  recipes        Recipe[]
  sales          Sale[]
  stockMovements StockMovement[]

  @@map("products")
}

model Material {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String   @map("producto")
  code         String?  @map("codificacion")
  unitId       String   @map("unit_id")
  stock        Float    @default(0) @map("actual")
  previous     Float?   @map("anterior")
  entries      Float?   @map("entradas")
  exits        Float?   @map("salidas")
  average      Float?   @map("promedio")
  unitPrice    Float?   @map("precio_unitario")
  warehouse    String?  @map("bodega_insumos")
  reorderPoint Float?   @map("reorder_point")
  branchId     String   @map("Sucursal")
  unit         Unit     @relation(fields: [unitId], references: [id])
  branch       Branch   @relation(fields: [branchId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id])
  recipes      Recipe[]
  stockMovements StockMovement[]

  @@map("materials")
}

model Recipe {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  materialId String   @map("material_id")
  quantity   Float
  material   Material @relation(fields: [materialId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([productId, materialId])
  @@map("recipes")
}

model Sale {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  productId   String   @map("product_id")
  quantity    Float
  saleDate    DateTime @map("sale_date")
  xmlFilename String?  @map("xml_filename")
  branchId    String   @map("Sucursal")
  branch      Branch   @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  product     Product  @relation(fields: [productId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("sales")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String?      @map("product_id")
  materialId    String?      @map("material_id")
  userId        String       @map("user_id")
  branchId      String?      @map("branch_id")
  quantity      Float?
  type          MovementType // "IN" | "OUT" | "ADJUSTMENT"
  previousStock Float?
  newStock      Float?
  movementDate  DateTime     @default(now()) @map("movement_date")
  createdAt     DateTime     @default(now()) @map("created_at")

  product  Product? @relation(fields: [productId], references: [id])
  material Material? @relation(fields: [materialId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@map("stock_movements")
}
